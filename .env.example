# Non-secret, environment-specific values the n8n host provides to workflows (read as $env.NAME).
# Base URLs, hostnames and recipient addresses belong here, never hardcoded in a workflow.
# Add one NAME= line for every variable a workflow reads.
# n8n 2.x blocks $env inside nodes ("access to env vars denied") unless the n8n host sets
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false. Keep this line while any workflow reads $env.NAME.
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Remove a NAME= line when no workflow reads it any more (the validator warns about unused ones).
TELEGRAM_ADMIN_CHAT_ID=
ANALYTICS_WEBHOOK_URL=
