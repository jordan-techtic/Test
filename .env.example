# Non-secret, environment-specific values the n8n host provides to workflows (read as $env.NAME).
# Base URLs, hostnames and recipient addresses belong here, never hardcoded in a workflow.
# Add one NAME= line for every variable a workflow reads.
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
ADMIN_ALERT_WEBHOOK_URL=
N8N_WEBHOOK_BASE_URL=
GMAIL_API_BASE_URL=https://gmail.googleapis.com
GMAIL_WARMUP_USER_ID=me
GMAIL_WARMUP_QUERY=label:inbox
GMAIL_WARMUP_REPLY_BODY=Thanks for your message. This is an automated warmup reply.