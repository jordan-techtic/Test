{
  "name": "AI Email Agent",
  "id": "ai-email-agent",
  "active": false,
  "settings": {
    "executionTimeout": 600,
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "sn1",
      "name": "Assumptions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        0
      ],
      "parameters": {
        "content": "Assumptions: jwtAuth on POST /email/new; webhook subject/body canonical; Gmail GET when emailId has no ::; human approval via Wait resume URLs that include HMAC token (APPROVAL_RESUME_SECRET); token verified after Wait before send; Sheets/env from $env; Calendar when classification mentions meeting; OpenAI JSON category field.",
        "height": 320,
        "width": 420
      }
    },
    {
      "id": "n1",
      "name": "New Email Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "email/new",
        "authentication": "jwtAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "credentials": {
        "jwtAuth": {
          "id": "jwt1",
          "name": "Inbound Email Webhook JWT"
        }
      }
    },
    {
      "id": "n2",
      "name": "Normalize Email Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "emailId",
              "value": "={{ $json.body.email.id ?? $json.body.email.messageId ?? ($json.body.email.subject + '::' + $json.body.email.body) }}",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "subject",
              "value": "={{ $json.body.email.subject }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "body",
              "value": "={{ $json.body.email.body }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "replyToEmail",
              "value": "={{ $json.body.email.from ?? $json.body.email.replyTo ?? $env.ADMIN_EMAIL }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Remove Duplicate Emails",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.emailId }}",
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Gmail Id Present",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.emailId }}",
              "rightValue": "::",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n5",
      "name": "Fetch Gmail Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        180
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages/{{ $json.emailId }}?format=full",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "gm1",
          "name": "Gmail OAuth2 API"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n6",
      "name": "Prepare Email Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "emailId",
              "value": "={{ $('Normalize Email Input').item.json.emailId }}",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "subject",
              "value": "={{ $('Normalize Email Input').item.json.subject }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "body",
              "value": "={{ $('Fetch Gmail Message').isExecuted ? ($json.snippet ?? $('Normalize Email Input').item.json.body) : $('Normalize Email Input').item.json.body }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "replyToEmail",
              "value": "={{ $('Normalize Email Input').item.json.replyToEmail }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n7",
      "name": "Classify Email",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": "gpt-4o-mini",
        "prompt": {
          "messages": [
            {
              "role": "user",
              "content": "=Classify this email. Reply with JSON only using keys category (meeting|support|general|other) and summary.\n\nSubject: {{ $json.subject }}\n\nBody: {{ $json.body }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "oa1",
          "name": "OpenAI API"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n8",
      "name": "Log Classification",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.EMAIL_LOG_SHEET_ID }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $env.EMAIL_LOG_SHEET_TAB }}"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "emailId": "={{ $('Prepare Email Context').item.json.emailId }}",
            "subject": "={{ $('Prepare Email Context').item.json.subject }}",
            "classification": "={{ $('Classify Email').item.json.message.content }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gs1",
          "name": "Google Sheets OAuth2"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n9",
      "name": "Classification Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Classify Email').item.json.message.content }}",
              "rightValue": "category",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n10",
      "name": "Record Classification Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2160,
        480
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "stage",
              "value": "Classify Email",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "errorMessage",
              "value": "={{ String($('Classify Email').item.json.message.content ?? 'classification missing category').slice(0, 200) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n11",
      "name": "Meeting Related",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('Classify Email').item.json.message.content }}",
              "rightValue": "meeting",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n12",
      "name": "Get Calendar Context",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        2400,
        180
      ],
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary"
        },
        "timeMin": "={{ $now.toISO() }}",
        "timeMax": "={{ $now.plus({ days: 7 }).toISO() }}",
        "returnAll": false,
        "limit": 10,
        "options": {}
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "gc1",
          "name": "Google Calendar OAuth2"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n13",
      "name": "Draft Reply",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.1,
      "position": [
        2640,
        300
      ],
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": "gpt-4o-mini",
        "prompt": {
          "messages": [
            {
              "role": "user",
              "content": "=Draft a concise professional email reply.\nClassification: {{ $('Classify Email').item.json.message.content }}\nCalendar (if any): {{ $('Get Calendar Context').isExecuted ? JSON.stringify($('Get Calendar Context').all()) : 'none' }}\n\nOriginal subject: {{ $('Prepare Email Context').item.json.subject }}\nOriginal body: {{ $('Prepare Email Context').item.json.body }}\n\nReply with JSON: {\"replyBody\":\"...\"}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "oa1",
          "name": "OpenAI API"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n14",
      "name": "Hold Draft for Approval",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2880,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "emailId",
              "value": "={{ $('Prepare Email Context').item.json.emailId }}",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "subject",
              "value": "={{ $('Prepare Email Context').item.json.subject }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "draftReply",
              "value": "={{ $('Draft Reply').item.json.message.content }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "approvalStatus",
              "value": "pending",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n14a",
      "name": "Sign Approval Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nconst draft = $('Hold Draft for Approval').first().json;\nconst secret = $env.APPROVAL_RESUME_SECRET;\nif (!secret) {\n  throw new Error('APPROVAL_RESUME_SECRET is not configured');\n}\nconst token = crypto.createHmac('sha256', secret).update(String($execution.id) + ':' + draft.emailId).digest('hex');\nreturn [{ json: { ...draft, approvalToken: token } }];"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "n15",
      "name": "Email Approval Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { raw: Buffer.from('To: ' + $env.ADMIN_EMAIL + '\\r\\nSubject: Approve AI email reply\\r\\n\\r\\nReply draft:\\r\\n' + $('Sign Approval Token').item.json.draftReply + '\\r\\n\\r\\nApprove: ' + $execution.resumeUrl + '?approved=true&token=' + $('Sign Approval Token').item.json.approvalToken + '\\r\\nReject: ' + $execution.resumeUrl + '?approved=false&token=' + $('Sign Approval Token').item.json.approvalToken).toString('base64') } }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "gm2",
          "name": "Gmail OAuth2 API"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n16",
      "name": "Wait for Human Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3480,
        300
      ],
      "parameters": {
        "resume": "webhook",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 72,
        "resumeUnit": "hours"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n16a",
      "name": "Verify Approval Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query?.token ?? $json.body?.token ?? '' }}",
              "rightValue": "={{ $('Sign Approval Token').item.json.approvalToken }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n16b",
      "name": "Record Invalid Approval Token",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3720,
        480
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "stage",
              "value": "Verify Approval Token",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "errorMessage",
              "value": "invalid or missing approval token on resume",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n17",
      "name": "Approval Granted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3960,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query?.approved ?? $json.body?.approved ?? '' }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n18",
      "name": "Send Approved Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3840,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "oAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { raw: Buffer.from('To: ' + $('Prepare Email Context').item.json.replyToEmail + '\\r\\nSubject: Re: ' + $('Hold Draft for Approval').item.json.subject + '\\r\\n\\r\\n' + $('Hold Draft for Approval').item.json.draftReply).toString('base64') } }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "gm3",
          "name": "Gmail OAuth2 API"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "n19",
      "name": "Stop Without Sending",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        3840,
        400
      ],
      "parameters": {}
    },
