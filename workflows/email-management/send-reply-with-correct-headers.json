    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "th1",
              "name": "messageId",
              "value": "={{ (() => { const msgs = $json.messages || []; const last = msgs[msgs.length - 1]; if (!last) return ''; const headers = (last.payload && last.payload.headers) || []; const h = headers.find(x => String(x.name || '').toLowerCase() === 'message-id'); return h ? String(h.value || '').trim() : ''; })() }}",
              "type": "string"
            },
            {
              "id": "th2",
              "name": "references",
              "value": "={{ (() => { const msgs = $json.messages || []; const last = msgs[msgs.length - 1]; if (!last) return ''; const headers = (last.payload && last.payload.headers) || []; const get = (n) => { const h = headers.find(x => String(x.name || '').toLowerCase() === n.toLowerCase()); return h ? String(h.value || '').trim() : ''; }; const messageId = get('Message-ID'); const prev = get('References'); return prev ? (prev + ' ' + messageId).trim() : messageId; })() }}",
              "type": "string"
            },
            {
              "id": "th3",
              "name": "replyTo",
              "value": "={{ (() => { const msgs = $json.messages || []; const last = msgs[msgs.length - 1]; if (!last) return ''; const headers = (last.payload && last.payload.headers) || []; const h = headers.find(x => String(x.name || '').toLowerCase() === 'from'); return h ? String(h.value || '').trim() : ''; })() }}",
              "type": "string"
            },
            {
              "id": "th4",
              "name": "replySubject",
              "value": "={{ (() => { const msgs = $json.messages || []; const last = msgs[msgs.length - 1]; if (!last) return 'Re:'; const headers = (last.payload && last.payload.headers) || []; const h = headers.find(x => String(x.name || '').toLowerCase() === 'subject'); const subj = h ? String(h.value || '').trim() : ''; if (!subj) return 'Re:'; return subj.toLowerCase().startsWith('re:') ? subj : 'Re: ' + subj; })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
