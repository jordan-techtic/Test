{
  "name": "Chatbot - Send Answer to User",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "chatId",
              "type": "string"
            },
            {
              "name": "replyText",
              "type": "string"
            }
          ]
        }
      },
      "id": "61111111-2222-4333-8444-555555555601",
      "name": "Sub-Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.replyText }}",
        "additionalFields": {}
      },
      "id": "61111111-2222-4333-8444-555555555602",
      "name": "Send Telegram Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "71111111-2222-4333-8444-555555555603",
              "name": "stage",
              "value": "send-answer-to-user",
              "type": "string"
            },
            {
              "id": "71111111-2222-4333-8444-555555555604",
              "name": "errorMessage",
              "value": "={{ $json.error?.message ?? $json.error ?? 'Telegram message send failed' }}",
              "type": "string"
            },
            {
              "id": "71111111-2222-4333-8444-555555555605",
              "name": "chatId",
              "value": "={{ $('Sub-Workflow Trigger').item.json.chatId ?? '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "61111111-2222-4333-8444-555555555603",
      "name": "Handle Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        220
      ]
    }
  ],
  "connections": {
    "Sub-Workflow Trigger": {
      "main": [
        [
          {
            "node": "Send Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram Message": {
      "error": [
        [
          {
            "node": "Handle Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
