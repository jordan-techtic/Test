              "value": "={{ $json.error?.message ?? $json.error ?? 'Webhook message reception failed' }}",
              "type": "string"
            },
            {
              "id": "b8c9d0e1-f2a3-4456-b789-abcdef012345",
              "name": "raw",
              "value": "={{ JSON.stringify($json) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c9d0e1f2-a3b4-4567-c890-abcdef012345",
      "name": "Handle Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        220
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Normalize Message",
