{
  "name": "Chatbot - Receive User Message",
  "nodes": [
    {
      "parameters": {
        "content": "## Assumptions\n- **Webhook (not Telegram Trigger):** Ticket specifies a webhook trigger; Telegram updates are POSTed as JSON (e.g. test payload `{\"message\": {\"text\": \"Hello!\"}}`).\n- **No downstream workflow:** This ticket only receives and normalizes input; it does not call **Chatbot - Generate AI Response**.",
        "height": 220,
        "width": 420
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Assumptions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -120
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chatbot/receive-user-message",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Webhook Telegram",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "chatbot-receive-user-message",
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "Telegram Webhook Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.body && typeof item.body === 'object' ? item.body : item;\nconst message = payload.message;\n\nif (!message || typeof message.text !== 'string' || !message.text.trim()) {\n  throw new Error('Invalid Telegram update: expected message.text');\n}\n\nreturn [\n  {\n    json: {\n      userMessageText: message.text,\n      chatId: message.chat && message.chat.id != null ? message.chat.id : null,\n      update: payload,\n      receivedAt: new Date().toISOString(),\n    },\n  },\n];"
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "Prepare User Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "d4e5f6a7-b8c9-0123-def0-234567890123",
      "name": "Prepared For Chatbot",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "stage",
              "value": "receive-user-message",
              "type": "string"
            },
            {
              "id": "e2",
              "name": "error",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "e3",
              "name": "errorMessage",
              "value": "={{ $json.error && $json.error.message ? $json.error.message : 'Message reception failed' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-1234-ef01-345678901234",
      "name": "Handle Reception Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        220
      ]
    }
  ],
  "connections": {
