              "value": "={{ $json.body?.message?.chat?.id ?? $json.message?.chat?.id ?? '' }}",
              "type": "string"
            },
            {
              "id": "d4e5f6a7-b8c9-4012-d345-6789abcdef01",
              "name": "source",
              "value": "telegram",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-4123-e456-789abcdef012",
      "name": "Normalize Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f6a7b8c9-d0e1-4234-f567-89abcdef0123",
              "name": "stage",
              "value": "receive-user-message",
              "type": "string"
            },
            {
              "id": "a7b8c9d0-e1f2-4345-a678-9abcdef01234",
