            {
              "id": "p2",
              "name": "variantsJson",
              "value": "={{ ($json.choices && $json.choices[0] && $json.choices[0].message && $json.choices[0].message.content) ? String($json.choices[0].message.content).trim() : '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "99451122-c299-4000-d3bb-223344556677",
      "name": "Parse Variants Json",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        -240
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ev1",
              "name": "requestId",
              "value": "={{ $json.requestId }}",
              "type": "string"
            },
            {
              "id": "ev2",
              "name": "variantsValid",
              "value": "={{ (() => { try { const o = JSON.parse($json.variantsJson || '{}'); if (!Array.isArray(o.variants) || o.variants.length < 1 || o.variants.length > 5) return false; const greeting = /^(Hello|Hi|Dear|Greetings)\\b/i; return o.variants.every(v => { const subject = String(v && v.subject || '').trim(); const body = String(v && v.body || '').trim(); if (subject.length < 3 || body.length < 10) return false; if (!greeting.test(body)) return false; if (!/Best regards,\\s*$/i.test(body)) return false; return true; }); } catch { return false; } })() }}",
              "type": "boolean"
            },
            {
              "id": "ev3",
              "name": "variantCount",
              "value": "={{ (() => { try { const o = JSON.parse($json.variantsJson || '{}'); return Array.isArray(o.variants) ? o.variants.length : 0; } catch { return 0; } })() }}",
              "type": "number"
            },
            {
              "id": "ev4",
              "name": "variantsJson",
              "value": "={{ $json.variantsJson }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
