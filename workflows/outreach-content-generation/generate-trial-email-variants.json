        "options": {
          "timeout": 90000
        }
      },
      "id": "99450011-b188-4999-c2aa-112233445566",
      "name": "OpenAI Generate Trial Variants",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
