              "type": "boolean"
            },
            {
              "id": "ev3",
              "name": "variantCount",
              "value": "={{ (() => { try { const o = JSON.parse($json.variantsJson || '{}'); return Array.isArray(o.variants) ? o.variants.length : 0; } catch { return 0; } })() }}",
              "type": "number"
            },
