        "jsonBody": "={\n  \"errorId\": {{ JSON.stringify($('Route Error').item.json.errorId) }},\n  \"details\": {{ JSON.stringify($('Route Error').item.json.details) }},\n  \"queue\": \"admin-exception\",\n  \"reason\": \"retries-unsafe-or-exhausted\"\n}",
        "options": {}
