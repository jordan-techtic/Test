      ]
    },
    {
      "parameters": {
        "jsCode": "const errorId = $input.first().json.errorId;\nconsole.log('Duplicate errorId ignored', errorId);\nreturn [];"
      },
      "id": "e67f8a9b-0c1d-4e2f-3a4b-6c7d8e9f0a1b",
      "name": "Log Duplicate Error",
      "type": "n8n-nodes-base.code",
