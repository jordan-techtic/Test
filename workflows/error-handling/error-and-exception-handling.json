        "url": "https://mpa-api.example/v1/errors/record",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"errorId\": {{ JSON.stringify($json.errorId) }},\n  \"details\": {{ JSON.stringify($json.details) }},\n  \"retryCount\": {{ $json.retryCount }},\n  \"maxRetries\": {{ $json.maxRetries }},\n  \"retrySafe\": {{ $json.retrySafe }}\n}",
        "options": {}
      },
      "id": "10000008-aaaa-bbbb-cccc-000000000008",
      "name": "Record Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        460
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "mpa-api-cred-id",
          "name": "MPA API service credential"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "needs-ticket",
              "leftValue": "={{ $('Route Error').item.json.needsTicket }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "10000009-aaaa-bbbb-cccc-000000000009",
      "name": "Retries Unsafe Or Exhausted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
