      "id": "10000004-aaaa-bbbb-cccc-000000000004",
      "name": "Log Invalid Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst errorId = String(body.errorId ?? '').trim();\nconst details = String(body.details ?? body.message ?? '').trim();\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.seenErrorIds) staticData.seenErrorIds = {};\nif (staticData.seenErrorIds[errorId]) {\n  return [{ json: { errorId, details, route: 'duplicate' } }];\n}\nstaticData.seenErrorIds[errorId] = new Date().toISOString();\n\nconst retryCount = Number(body.retryCount ?? 0);\nconst maxRetries = Number(body.maxRetries ?? 2);\nconst retrySafe = body.retrySafe !== false;\nconst needsTicket = !retrySafe || retryCount >= maxRetries;\n\nreturn [{\n  json: {\n    errorId,\n    details,\n    retryCount,\n    maxRetries,\n    retrySafe,\n    needsTicket,\n    route: needsTicket ? 'ticket' : 'retry',\n  },\n}];"
      },
