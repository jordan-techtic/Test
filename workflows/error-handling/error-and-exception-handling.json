{
  "name": "Error and Exception Handling",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "error",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e01f2a3b-4c5d-4e6f-7a8b-9c0d1e2f3a4b",
      "name": "Error Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "error-handling-webhook",
      "credentials": {
        "httpHeaderAuth": {
          "id": "mpa-api-service",
          "name": "MPA API Service"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body ?? item;\nconst errorId = body.errorId;\nconst details = body.details;\nconst payloadOk =\n  typeof errorId === 'string' &&\n  errorId.trim().length > 0 &&\n  details !== undefined &&\n  details !== null &&\n  (typeof details === 'string' ? details.trim().length > 0 : true);\nlet parsedDetails = details;\nif (typeof details === 'string') {\n  try {\n    parsedDetails = JSON.parse(details);\n  } catch {\n    parsedDetails = { message: details };\n  }\n}\nreturn [\n  {\n    json: {\n      errorId: typeof errorId === 'string' ? errorId.trim() : errorId,\n      details,\n      parsedDetails,\n      payloadOk,\n      raw: body,\n    },\n  },\n];"
      },
      "id": "f12a3b4c-5d6e-4f7a-8b9c-0d1e2f3a4b5c",
      "name": "Prepare Error Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-error-payload",
              "leftValue": "={{ $json.payloadOk }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a23b4c5d-6e7f-4a8b-9c0d-1e2f3a4b5c6d",
      "name": "Payload Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.raw;\nconsole.log('Invalid error payload ignored', JSON.stringify(raw));\nreturn [];"
      },
      "id": "b34c5d6e-7f8a-4b9c-0d1e-2f3a4b5c6d7e",
      "name": "Log Invalid Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.errorIds) {\n  staticData.errorIds = {};\n}\nconst errorId = $input.first().json.errorId;\nconst isDuplicate = Object.prototype.hasOwnProperty.call(staticData.errorIds, errorId);\nif (!isDuplicate) {\n  staticData.errorIds[errorId] = new Date().toISOString();\n}\nreturn [\n  {\n    json: {\n      ...$input.first().json,\n      isDuplicate,\n    },\n  },\n];"
      },
      "id": "c45d6e7f-8a9b-4c0d-1e2f-3a4b5c6d7e8f",
      "name": "Dedupe Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-error-dup",
              "leftValue": "={{ $json.isDuplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d56e7f8a-9b0c-4d1e-2f3a-5b6c7d8e9f0a",
      "name": "Is Duplicate",
