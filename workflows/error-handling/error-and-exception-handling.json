        "jsonBody": "={\n  \"team\": \"admin\",\n  \"channel\": \"email\",\n  \"subject\": \"Error handling workflow failure\",\n  \"errorId\": {{ JSON.stringify($('Route Error').item.json.errorId ?? $('Error Report Webhook').item.json.body?.errorId ?? '') }},\n  \"errorMessage\": {{ JSON.stringify($json.error?.message ?? $json.message ?? 'Error handling step failed') }},\n  \"failedNode\": {{ JSON.stringify($json.error?.node?.name ?? 'Record Error') }}\n}",
        "options": {}
