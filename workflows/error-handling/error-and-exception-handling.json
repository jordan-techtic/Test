    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.MPA_SERVICE_URL || '').replace(/\\/$/, '') + '/admin/errors/record' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ errorId: $json.errorId, details: $json.details }) }}",
        "options": {}
      },
      "id": "f78a9b0c-1d2e-4f3a-4b5c-7d8e9f0a1b2c",
      "name": "Record Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "mpa-api-service",
          "name": "MPA API Service"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Dedupe Error').item.json;\nconst record = $input.first().json;\nconst parsed = base.parsedDetails || {};\nconst response = record.body || record;\nconst merged = { ...parsed, ...(response.body || response) };\nconst ticketRequired =\n  merged.retriesExhausted === true ||\n  merged.retriesUnsafe === true ||\n  merged.createExceptionTicket === true;\nreturn [\n  {\n    json: {\n      errorId: base.errorId,\n      details: base.details,\n      ticketRequired,\n      recordResponse: record,\n    },\n  },\n];"
      },
      "id": "a89b0c1d-2e3f-4a4b-5c6d-8e9f0a1b2c3d",
      "name": "Evaluate Retry Policy",
      "type": "n8n-nodes-base.code",
