            {
              "id": "log-msg",
              "name": "message",
              "value": "={{ 'Ignored invalid Ready request: missing requestId or qaResult. Payload keys: ' + Object.keys($json).join(', ') }}",
              "type": "string"
            },
            {
              "id": "log-req",
              "name": "requestId",
              "value": "={{ $json.requestId }}",
              "type": "string"
            },
            {
              "id": "log-qa",
              "name": "qaResult",
