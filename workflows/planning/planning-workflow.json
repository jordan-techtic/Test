      "position": [
        760,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.seenRequestIds) staticData.seenRequestIds = {};\n\nconst item = $input.first().json;\nconst requestId = String(item.requestId ?? '').trim();\nconst qaResult = String(item.qaResult ?? '').trim();\n\nif (staticData.seenRequestIds[requestId]) {\n  return [{ json: { status: 'duplicate', requestId, qaResult } }];\n}\n\nstaticData.seenRequestIds[requestId] = new Date().toISOString();\nreturn [{ json: { status: 'notify', requestId, qaResult } }];"
      },
      "id": "e5f6a7b8-c9d0-1234-ef01-345678901234",
      "name": "Check Duplicate requestId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
