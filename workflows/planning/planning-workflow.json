        "specifyBody": "json",
        "jsonBody": "={\n  \"team\": \"planning\",\n  \"channel\": \"email\",\n  \"subject\": \"Planning workflow failure\",\n  \"requestId\": {{ JSON.stringify($('Ready Request').item.json.requestId ?? $json.requestId ?? '') }},\n  \"qaResult\": {{ JSON.stringify($('Ready Request').item.json.qaResult ?? $json.qaResult ?? '') }},\n  \"errorMessage\": {{ JSON.stringify($json.error?.message ?? $json.message ?? 'Notification or deduplication step failed') }},\n  \"failedNode\": {{ JSON.stringify($json.error?.node?.name ?? 'Notify Planning Personnel') }}\n}",
        "options": {}
