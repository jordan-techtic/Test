        "options": {}
      },
      "id": "d4e5f6a7-b8c9-0123-def0-234567890123",
      "name": "Record Invalid Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        760,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.seenRequestIds) staticData.seenRequestIds = {};\n\nconst item = $input.first().json;\nconst requestId = String(item.requestId ?? '').trim();\nconst qaResult = String(item.qaResult ?? '').trim();\nconst details = String(item.details ?? item.qaResult ?? '').trim();\n\nif (staticData.seenRequestIds[requestId]) {\n  return [{ json: { status: 'duplicate', requestId, qaResult, details } }];\n}\n\nstaticData.seenRequestIds[requestId] = new Date().toISOString();\nreturn [{ json: { status: 'notify', requestId, qaResult, details } }];"
      },
      "id": "e5f6a7b8-c9d0-1234-ef01-345678901234",
      "name": "Check Duplicate requestId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        380
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
