              }
            },
            {
              "id": "sa000008-0008-4008-8008-000000000008",
              "leftValue": "={{ String($json.message?.snippet || $json.snippet || $json.text || '').trim() }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
