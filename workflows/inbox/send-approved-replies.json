        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "sa000007-0007-4007-8007-000000000007",
              "leftValue": "={{ $json.id || '' }}",
              "rightValue": "",
