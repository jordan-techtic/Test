    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst from =\n  typeof item.from === 'object'\n    ? item.from.text || item.from.value || ''\n    : String(item.from || '');\nlet body = item.textPlain || item.text || item.snippet || '';\nif (typeof body !== 'string') body = String(body);\nconst lines = body.split(/\\r?\\n/);\nconst kept = [];\nfor (const line of lines) {\n  const t = line.trim();\n  if (t.startsWith('>')) continue;\n  if (/^on .+ wrote:$/i.test(t)) break;\n  kept.push(line);\n}\nbody = kept.join('\\n').trim();\nconst sig = body.search(/\\n--\\s*\\n/);\nif (sig >= 0) body = body.slice(0, sig).trim();\nif (body.length > 4000) body = body.slice(0, 4000);\nlet autoSubmitted = '';\nconst headers = item.headers;\nif (Array.isArray(headers)) {\n  const h = headers.find((x) => String(x.name || '').toLowerCase() === 'auto-submitted');\n  if (h) autoSubmitted = String(h.value || '');\n}\nconst fromL = from.toLowerCase();\nconst subj = String(item.subject || '');\nconst isAutomatic =\n  fromL.includes('no-reply') ||\n  (autoSubmitted !== '' && autoSubmitted.toLowerCase() !== 'no') ||\n  /^out of office/i.test(subj);\nreturn {\n  json: {\n    id: item.id,\n    threadId: item.threadId,\n    from,\n    subject: subj,\n    snippet: item.snippet || '',\n    body,\n    isAutomatic,\n  },\n};"
      },
