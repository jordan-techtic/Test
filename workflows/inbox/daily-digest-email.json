      },
      "id": "dd000002-0002-4002-8002-000000000002",
      "name": "Find Needs Human",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        220,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "3",
          "name": "Gmail OAuth2"
        }
      },
      "retryOnFail": true,
