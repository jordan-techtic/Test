    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "chatModel": "={{ $env.OPENAI_MODEL }}",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You write polite support email replies. Use the sender's language. Stay under 150 words. Be helpful but do not promise refunds, dates, or outcomes. Do not invent facts. Do not include links or currency amounts. Do not use the words guarantee or promise. Sign the reply exactly as instructed in the user message."
            },
            {
              "role": "user",
              "content": "={{ 'Category: ' + ($('When Called').item.json.category || '') + '\\nSubject: ' + ($('When Called').item.json.subject || '') + '\\n\\nCustomer message:\\n' + String($('When Called').item.json.body || '').slice(0, 4000) + '\\n\\nSign as: ' + ($env.REPLY_SIGNATURE || '') }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "maxTokens": 400,
          "timeout": 30000
        },
        "requestOptions": {}
      },
      "id": "dr000007-0007-4007-8007-000000000007",
      "name": "Write Reply",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.1,
      "position": [
        660,
        60
      ],
      "credentials": {
        "openAiApi": {
          "id": "4",
          "name": "OpenAI API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nlet text =\n  item.message?.content ??\n  item.text ??\n  item.content ??\n  item.choices?.[0]?.message?.content ??\n  '';\nif (typeof text === 'object' && text !== null) text = JSON.stringify(text);\ntext = String(text).trim();\nconst link = /https?:\\/\\//i.test(text);\nconst currency = /(?:\\$|€|£)\\s?\\d|(?:\\d+[.,]\\d{2}\\s?(?:usd|eur|gbp))/i.test(text);\nconst banned = /\\b(guarantee|promise)\\b/i.test(text);\nconst ok = text.length > 0 && text.length <= 1200 && !link && !currency && !banned;\nreturn { json: { replyText: text, ok } };"
      },
      "id": "dr000008-0008-4008-8008-000000000008",
      "name": "Check Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
