    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.seenBriefIds) staticData.seenBriefIds = {};\n\nconst raw = $input.first().json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nconst briefId = String(body.briefId ?? '').trim();\nconst content = String(body.content ?? '').trim();\n\nif (staticData.seenBriefIds[briefId]) {\n  return [{ json: { briefId, content, route: 'duplicate' } }];\n}\nstaticData.seenBriefIds[briefId] = new Date().toISOString();\n\nconst minLength = 5;\nconst valid = content.length >= minLength;\nconst gaps = valid\n  ? []\n  : [`Brief content must be at least ${minLength} characters (received ${content.length}).`];\n\nreturn [{\n  json: {\n    briefId,\n    content,\n    route: valid ? 'planning' : 'gap',\n    valid,\n    gaps,\n  },\n}];"
      },
