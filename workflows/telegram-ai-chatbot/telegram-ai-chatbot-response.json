      "name": "Message Is Text",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1b2c3d4-e5f6-4789-a012-startcmd00001",
              "leftValue": "={{ $json.body?.message?.text ?? $json.message?.text ?? '' }}",
              "rightValue": "/start",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "g1h2i3j4-k5l6-4m7n-8o9p-0q1r2s3t4u5v",
      "name": "Start Command",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        -40
      ]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "message",
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "={{ $('Webhook').item.json.body?.message?.text ?? $('Webhook').item.json.message?.text ?? '' }}"
            }
          ]
        },
        "options": {
          "maxTokens": 500,
          "temperature": 0.7
        }
      },
      "id": "b8c9d0e1-2f3a-4b5c-9d0e-1f2a3b4c5d6e",
      "name": "Send to OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.1,
      "position": [
        720,
        -120
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Keyword rules (upstream IF nodes decide routing; this node runs only when all pass):\n\n1. **Message Is Text** — `body.message.text` or `message.text` must be a non-empty string. Otherwise the update stops at **Ignore Non-Text** (no OpenAI call).\n2. **Start Command** — text that equals `/start` gets a fixed welcome reply via **Send Telegram Reply** and is not sent to OpenAI.\n3. **OpenAI path** — every other non-empty text message is forwarded here as the user chat message.\n\nThere is no separate keyword allow/deny list in this workflow; routing is by presence of text and the `/start` command only.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Webhook').item.json.body?.message?.chat?.id ?? $('Webhook').item.json.message?.chat?.id ?? $('Webhook').item.json.message?.chat_id ?? $('Webhook').item.json.chat_id }}",
        "text": "={{ (($('Webhook').item.json.body?.message?.text ?? $('Webhook').item.json.message?.text) === '/start') ? 'Welcome! I am your AI assistant. Send a text message to chat.' : ($json.message?.content || $json.choices?.[0]?.message?.content || $json.text || '') }}",
        "additionalFields": {}
      },
      "id": "c9d0e1f2-3a4b-5c6d-0e1f-2a3b4c5d6e7f",
      "name": "Send Telegram Reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        -80
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "h2i3j4k5-0001-4001-8001-000000000001",
              "name": "stage",
              "value": "={{ $json.error?.node?.name ?? 'unknown' }}",
              "type": "string"
            },
            {
              "id": "h2i3j4k5-0002-4002-8002-000000000002",
              "name": "errorMessage",
              "value": "={{ String($json.error?.message ?? $json.error?.description ?? 'Workflow step failed').slice(0, 200) }}",
              "type": "string"
            },
            {
              "id": "h2i3j4k5-0003-4003-8003-000000000003",
              "name": "at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "h2i3j4k5-l6m7-4n8o-9p0q-1r2s3t4u5v6w",
      "name": "Prepare Error Log",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
        120
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_ADMIN_CHAT_ID }}",
        "text": "=Chatbot step failed ({{ $json.stage }}): {{ $json.errorMessage }} at {{ $json.at }}",
        "additionalFields": {}
      },
      "id": "i3j4k5l6-m7n8-4o9p-0q1r-2s3t4u5v6w7x",
