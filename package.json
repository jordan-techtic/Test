{
  "name": "marketing-content-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
    "test": "node ./node_modules/jest/bin/jest.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --noEmit",
    "postinstall": "node -e \"const fs=require('fs'); const bins=['typescript/bin/tsc','eslint/bin/eslint.js','vite/bin/vite.js']; for (const bin of bins) { if (!fs.existsSync('node_modules/'+bin)) { console.error('Missing '+bin+'. Re-run npm install.'); process.exit(1);} }\""
  },
  "dependencies": {
    "@eslint/js": "^9.24.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
